rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Fetches members[] of the parent chat document (for subcollection guards)
    function chatMembers(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // True if the parent chat is read-only (e.g. BAMA System DMs). Clients may
    // not post into it; the Admin SDK (bypasses rules) still can.
    function chatReadOnly(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.get('readOnly', false) == true;
    }

    // Fetches the parent project document data
    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    // Pricing & lifecycle fields — written ONLY by the Admin SDK (hireProfessional,
    // confirmCompletion, cancelProject, freeSlot, markFeePaid, lifecycleCron).
    // A client that could write these could free its own slot, unset the fee, or
    // fake completion — the whole collection mechanism is these fields.
    function serverOnlyProjectFields() {
      return [
        'filledSlots', 'professionalIds', 'chatId',
        'feeStatus', 'feeRate', 'feeDue', 'feePaid', 'feePaidAt',
        'feeLockedAt', 'feeLockedAmount', 'slotActive', 'slotHolders',
        'completion', 'expectedEndDate', 'endDatePromptedAt',
        'archivedUnconfirmedAt', 'refundReviewPending',
        'completedAt', 'cancelledAt'
      ];
    }

    // An ACCEPTED offer's amount is the base the platform fee is computed from.
    // Either party could previously rewrite it at any time, including after
    // completion — so a professional could cut their accepted price just before
    // the client confirmed and shrink their own fee. Once accepted, the amount
    // and the offer's identity are frozen to everything except the Admin SDK
    // (which is how legitimate renegotiation now lands).
    function offerAmountFrozenOnceAccepted() {
      return resource.data.get('status', '') != 'accepted' ||
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['price', 'bundlePrice', 'individualTotal']);
    }

    // An offer can never be repointed at a different project or professional.
    function offerIdentityStable() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['projectId', 'professionalId']);
    }

    // `status` is not server-only — clients set 'open' at create and when
    // reposting roles. Only the TERMINAL transitions belong to the callables.
    function statusTransitionAllowed() {
      return request.resource.data.get('status', '') == resource.data.get('status', '') ||
        !(request.resource.data.get('status', '') in ['completed', 'cancelled']);
    }

    // True if the user is the project's client OR is in the project's group chat.
    // Professionals are added to the group chat's members[] when their offer is accepted.
    function isProjectParticipant(projectId) {
      let proj = projectDoc(projectId);
      return proj.clientId == request.auth.uid || (
        'chatId' in proj &&
        request.auth.uid in
          get(/databases/$(database)/documents/chats/$(proj.chatId)).data.members
      );
    }

    // ─── users ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      // Owners may update their own doc, but never their moderation state —
      // that is written only by the moderateUser callable (Admin SDK).
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderation']);
      allow delete: if false;

      match /profile/data {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }

      match /portfolio/{assetId} {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }
    }

    // ─── chats ──────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.members ||
        resource.data.type == 'community'  // all authed users can see community metadata for discovery
      );
      allow create: if isAuth() && (
        request.resource.data.type != 'community' || isAdmin()
      );
      allow update: if isAuth() && request.auth.uid in resource.data.members;
      allow delete: if false;

      // direct messages
      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in chatMembers(chatId);
        // No client writes into a read-only chat (BAMA System DMs); Admin SDK bypasses.
        allow create: if isAuth() && request.auth.uid in chatMembers(chatId) && !chatReadOnly(chatId);
        allow update, delete: if false;
      }

      // community sub-channels
      match /channels/{channelId} {
        allow read, create, update: if isAuth() && request.auth.uid in chatMembers(chatId);
        // Only the community owner may delete, and never the General/Market channels.
        // resource.data.get('kind','') returns '' when absent → legacy/normal channels
        // (no kind) stay deletable by the owner; General/Market (kind set) are blocked.
        allow delete: if isAuth()
          && get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
          && resource.data.get('kind', '') != 'general'
          && resource.data.get('kind', '') != 'market';

        match /messages/{messageId} {
          allow read, create: if isAuth() && request.auth.uid in chatMembers(chatId);
          allow update, delete: if false;
        }
      }

      // community join requests
      match /joinRequests/{requestId} {
        // LOAD-BEARING: ChatRoomScreen only runs the collection query when the
        // caller is the community OWNER (it returns early otherwise). That works
        // because the owner clause below reads the parent chat and is therefore
        // provable from the query. The `request.auth.uid == requestId` clause is
        // the document-ID wildcard, which a query can never bind — so if that
        // owner gate is ever removed, the listener will be denied in production
        // and (unless its error handler logs) will look like "no pending
        // requests". Same failure that hid the removal-request bug.
        allow create: if isAuth() && request.auth.uid == requestId;
        allow read: if isAuth() && (
          request.auth.uid == requestId  // requester can read their own join status
          || get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
          || isAdmin()
        );
        allow update: if isAuth() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
          || isAdmin()
        );
        // The requester may withdraw their own request while it is still
        // pending — never once the owner has approved or rejected it.
        allow delete: if isAuth()
          && request.auth.uid == requestId
          && resource.data.status == 'pending';
      }
    }

    // ─── communityRequests ──────────────────────────────────────────
    match /communityRequests/{requestId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ─── courses ────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();

      // Per-user "Visit course" markers — doc id is the clicking user's uid, so
      // the unique-visitor count can't be inflated (repeat taps overwrite one
      // doc, and a user may write only their own). Only admins read the count.
      match /clicks/{userId} {
        allow read: if isAdmin();
        allow create, update: if isAuth() && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    // ─── courseRequests ─────────────────────────────────────────────
    match /courseRequests/{requestId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ─── projects ───────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isAuth();    // professionals browse the noticeboard
      // Clients create projects. `filledSlots: []` is fine; every other lifecycle
      // field must be absent so a client cannot self-assign feeStatus at create.
      allow create: if isAuth() &&
        request.resource.data.get('filledSlots', []) == [] &&
        !request.resource.data.keys().hasAny(
          serverOnlyProjectFields().removeAll(['filledSlots'])
        );
      // Only the client may update, and never a server-owned field. The former
      // "professionals may update filledSlots" branch is gone — removal now goes
      // through the freeSlot callable, which also maintains professionalIds.
      allow update: if isAuth() &&
        resource.data.clientId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(serverOnlyProjectFields()) &&
        statusTransitionAllowed();
      // Deletion goes through the deleteProject callable (Admin SDK), which
      // cascades to priceOffers, bundleOffers, the fee subcollection and the
      // chat, and refuses once anyone is hired. A direct client delete could not
      // reach the fee docs at all — subcollections outlive their parent — and
      // would leave accepted offers orphaned, still priceable by computeProAmount.
      allow delete: if isAdmin();

      match /meetings/{meetingId} {
        allow read, create, update, delete: if isAuth() && isProjectParticipant(projectId);
      }

      match /missions/{missionId} {
        allow read, create, update, delete: if isAuth() && isProjectParticipant(projectId);
      }

      // Payment renegotiation — only the two parties involved
      match /paymentRequests/{paymentRequestId} {
        allow create: if isAuth() && request.resource.data.fromUserId == request.auth.uid;
        allow read: if isAuth() && (
          resource.data.fromUserId == request.auth.uid ||
          resource.data.toUserId == request.auth.uid
        );
        allow update: if isAuth() && resource.data.toUserId == request.auth.uid;
        allow delete: if false;
      }

      // Per-professional platform fee. Doc id IS the pro's uid.
      // Admin SDK only for writes — a pro who could write this could zero their
      // own fee or free their own slot, which is the entire collection mechanism.
      // Only the pro themself reads it: per spec §6 the CLIENT is never told that
      // a professional owes money, so the client has no read here either.
      match /fees/{proId} {
        // Keyed off the FIELD, not the {proId} wildcard. A wildcard cannot be
        // bound by a collection query, so the wildcard form permits a direct get
        // while silently denying slice 2's cross-project fee list. The document
        // id and the professionalId field are always the same value.
        allow read: if isAuth() && resource.data.professionalId == request.auth.uid;
        allow write: if false;
      }

      // Removal requests — document ID is the professionalId being removed
      match /removalRequests/{professionalId} {
        allow create: if isAuth() && projectDoc(projectId).clientId == request.auth.uid;
        allow read: if isAuth() && (
          professionalId == request.auth.uid ||
          projectDoc(projectId).clientId == request.auth.uid
        );
        // The professional answers the request. The CLIENT may also write it —
        // `requestRemoval` uses setDoc, so a second press is an update, and
        // without this a client could never re-request after the pro ignored
        // one. Constrained to 'pending': only the professional can accept.
        allow update: if isAuth() && (
          professionalId == request.auth.uid ||
          (projectDoc(projectId).clientId == request.auth.uid &&
           request.resource.data.status == 'pending')
        );
        // Cleared by the freeSlot callable (Admin SDK bypasses rules), never by a client.
        allow delete: if false;
      }
    }

    // ─── priceOffers ────────────────────────────────────────────────
    match /priceOffers/{offerId} {
      allow create: if isAuth() && request.resource.data.professionalId == request.auth.uid;
      allow read: if isAuth() && (
        resource.data.professionalId == request.auth.uid ||
        projectDoc(resource.data.projectId).clientId == request.auth.uid
      );
      allow update: if isAuth() && (
        resource.data.professionalId == request.auth.uid ||
        // Client accepts/rejects, including batch-rejecting competing offers
        projectDoc(resource.data.projectId).clientId == request.auth.uid
      ) && offerAmountFrozenOnceAccepted() && offerIdentityStable();
      allow delete: if false;
    }

    // ─── bundleOffers ───────────────────────────────────────────────
    match /bundleOffers/{offerId} {
      allow create: if isAuth() && request.resource.data.professionalId == request.auth.uid;
      allow read: if isAuth() && (
        resource.data.professionalId == request.auth.uid ||
        projectDoc(resource.data.projectId).clientId == request.auth.uid
      );
      allow update: if isAuth() && (
        resource.data.professionalId == request.auth.uid ||
        projectDoc(resource.data.projectId).clientId == request.auth.uid
      ) && offerAmountFrozenOnceAccepted() && offerIdentityStable();
      allow delete: if false;
    }

    // ─── marketplace_listings ────────────────────────────────────────
    match /marketplace_listings/{listingId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.posterId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.posterId == request.auth.uid ||       // seller: markHandedOver, cancel
        resource.data.buyerId == request.auth.uid ||        // buyer: confirmReceived, cancel
        // New buyer initiating purchase on an available listing (confirmPurchase)
        (resource.data.status == 'available' &&
         request.resource.data.buyerId == request.auth.uid)
      );
      allow delete: if isAuth() && (resource.data.posterId == request.auth.uid || isAdmin());
    }

    // ─── reviews ────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      // A held review must be invisible to the pro it is about — otherwise they
      // read the rating straight from the SDK and the hold buys nothing.
      //
      // GET and LIST are split because they are enforced differently.
      //
      // `get` is evaluated per document, so the full condition works. The
      // get() default keeps any legacy field-less review readable.
      allow get: if isAuth() && (
        resource.data.get('published', true) != false ||
        request.auth.uid != resource.data.professionalId
      );
      // `list` must be provable from the QUERY, not the document. The condition
      // above is NOT: production returned a professional their own held review
      // (rating and body) through where('professionalId','==',uid), while
      // denying a direct get on the very same document. A `.get(field, default)`
      // comparison does not constrain a query; a plain equality does — the
      // notifications rule proves the shape works, denying an unconstrained list
      // and allowing where('userId','==',uid).
      //
      // So every query on reviews must carry where('published','==',true).
      // No read path wants held reviews: the professional must not see them, and
      // public profiles and search only ever show published ones. The server
      // publishes via the Admin SDK, which bypasses rules.
      //
      // This depends on EVERY review carrying `published`
      // (scripts/backfill-review-published.mjs) — without the field the equality
      // is unsatisfiable and the document silently vanishes from every list.
      allow list: if isAuth() && resource.data.published == true;
      // published/visibleAt are resolved by the onReviewCreate trigger from the
      // project's feeStatus. A client that could set them would bypass the hold.
      allow create: if isAuth() &&
        request.resource.data.reviewerId == request.auth.uid &&
        !request.resource.data.keys().hasAny(['published', 'visibleAt']);
      allow update, delete: if false;  // reviews are immutable (Admin SDK bypasses)
    }

    // ─── reports ────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isAuth() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin();
      allow update: if isAdmin() || (
        // Reporter may add evidence images after initial submission
        isAuth() &&
        resource.data.reporterId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evidenceURLs'])
      );
      allow delete: if false;
    }

    // ─── adminActions ───────────────────────────────────────────────
    // Append-only evidence log. Written exclusively by the moderateUser
    // callable (Admin SDK bypasses rules); admins may read.
    match /adminActions/{actionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ─── cancellations ──────────────────────────────────────────────
    // Append-only audit trail of purchase cancellations (project cancellations
    // are read live from `projects`). Written by the cancelling user; only
    // admins read. Never editable.
    match /cancellations/{id} {
      allow create: if isAuth() && request.resource.data.actorId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ─── notifications ───────────────────────────────────────────────
    // Written exclusively by Cloud Functions (Admin SDK bypasses rules).
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ─── pushTokens ──────────────────────────────────────────────────
    // Device push tokens, keyed by the token string. Clients never read; the
    // Cloud Function sender uses the Admin SDK (bypasses rules). A user may
    // only claim/refresh a token for themselves, and delete their own on logout.
    match /pushTokens/{tokenId} {
      allow read: if false;
      allow create, update: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── videoJobs ───────────────────────────────────────────────────
    // Written exclusively by the transcoding Cloud Function (Admin SDK bypasses rules).
    // Clients read via onSnapshot to await job completion during video upload.
    match /videoJobs/{jobId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ─── projectApplications ─────────────────────────────────────────
    // Written client-side but not queried client-side (possible future admin view).
    match /projectApplications/{applicationId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ─── subscriptions ──────────────────────────────────────────────
    // Written ONLY by the Admin SDK (setSubscription today, Cardcom later). A pro
    // who could write this would grant themselves 'included' fees and an
    // unlimited slot cap. They may read their own to see plan, counter and dates.
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Collection-group read over every projects/{id}/fees/{proId}, so a pro can
    // list their own outstanding fees across projects in one query. The
    // subcollection rule above does NOT authorise a collectionGroup query — that
    // needs its own path-pattern match. Scoped identically: the doc id must be
    // the caller's uid, so this grants nothing the direct read does not.
    match /{path=**}/fees/{proId} {
      // Field-keyed for the same reason as the subcollection rule above: a
      // collectionGroup('fees').where('professionalId','==',uid) query cannot
      // bind {proId}, so the wildcard form would deny the very query this rule
      // exists to permit.
      allow read: if isAuth() && resource.data.professionalId == request.auth.uid;
      allow write: if false;
    }

    // ─── deny everything not explicitly listed ────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
