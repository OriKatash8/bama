rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Fetches members[] of the parent chat document (for subcollection guards)
    function chatMembers(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // True if the parent chat is read-only (e.g. BAMA System DMs). Clients may
    // not post into it; the Admin SDK (bypasses rules) still can.
    function chatReadOnly(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.get('readOnly', false) == true;
    }

    // Fetches the parent project document data
    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    // Pricing & lifecycle fields — written ONLY by the Admin SDK (hireProfessional,
    // confirmCompletion, cancelProject, freeSlot, markFeePaid, lifecycleCron).
    // A client that could write these could free its own slot, unset the fee, or
    // fake completion — the whole collection mechanism is these fields.
    function serverOnlyProjectFields() {
      return [
        'filledSlots', 'professionalIds', 'chatId',
        'feeStatus', 'feeRate', 'feeDue', 'feePaid', 'feePaidAt',
        'feeLockedAt', 'feeLockedAmount', 'slotActive', 'slotHolders',
        'completion', 'expectedEndDate', 'endDatePromptedAt',
        'archivedUnconfirmedAt', 'refundReviewPending',
        'completedAt', 'cancelledAt',
        // Admin-review flags, set by disputeFeeByPro and lifecycleCron. A client
        // that could write these could clear a dispute raised against it, or
        // flag a project to stall it — so they are server-only like the rest.
        'adminReviewPending', 'adminReview',
        // Stamped at confirmation; bounds the professional's dispute window. A
        // client that could write it could close the window on the same day.
        'disputeWindowEndsAt'
      ];
    }

    // An ACCEPTED offer's amount is the base the platform fee is computed from.
    // Either party could previously rewrite it at any time, including after
    // completion — so a professional could cut their accepted price just before
    // the client confirmed and shrink their own fee. Once accepted, the amount
    // and the offer's identity are frozen to everything except the Admin SDK
    // (which is how legitimate renegotiation now lands).
    function offerAmountFrozenOnceAccepted() {
      return resource.data.get('status', '') != 'accepted' ||
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['price', 'bundlePrice', 'individualTotal']);
    }

    // An offer can never be repointed at a different project or professional.
    function offerIdentityStable() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['projectId', 'professionalId']);
    }

    // ── Offer status: a TRANSITION PAIR, not a field allowlist ──────────────
    //
    // Deliberately expressed as (old status -> new status) read off
    // resource.data. A field allowlist would admit `accepted -> rejected`, and
    // that is the leak: computeProAmount (functions/src/lifecycle/helpers.ts:104)
    // derives the platform-fee base from `status == 'accepted'`, so a pro who
    // flipped their own accepted offer to 'rejected' would zero their own 3% fee
    // and still be counted settled at completion.
    //
    // Exactly ONE client transition survives: the receiving client declining a
    // pending offer (useAcceptOffer.ts:29 / useAcceptBundleOffer.ts:28).
    // Everything else — anything reaching 'accepted' or 'removed', and any move
    // out of a terminal state — belongs to hireProfessional / freeSlot, which
    // use the Admin SDK and bypass rules entirely.
    function offerStatusUnchanged() {
      return request.resource.data.get('status', '') == resource.data.get('status', '');
    }
    function offerClientDecline() {
      return resource.data.get('status', '') == 'pending'
        && request.resource.data.get('status', '') == 'rejected'
        && projectDoc(resource.data.projectId).clientId == request.auth.uid;
    }
    // Every field a client legitimately writes to an offer AFTER creation.
    // Pulled from the code, not guessed:
    //   price / bundlePrice / editedAt / editCount — NoticeHistorySheet.tsx:84-86
    //   bundleId                                   — usePriceOffer.ts:68-70 backfill
    //   status                                     — the decline above
    // Anything else, known or invented, is denied: `subcategory`, `createdAt`,
    // `slots`, `offerIds`, `individualTotal` are all write-once at create.
    function offerClientFields() {
      return ['status', 'price', 'bundlePrice', 'editedAt', 'editCount', 'bundleId'];
    }
    // An offer must be born pending, on a project that actually exists. Without
    // the first clause a professional could create an offer already 'accepted';
    // without the second, one pointing at a project id that was never real.
    function offerCreateValid() {
      return request.resource.data.professionalId == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('projectId', '') != ''
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && offerPriceInRange();
    }

    // ── Offer price bounds ──────────────────────────────────────────────────
    // A THIRD copy of MIN/MAX_OFFER_PRICE: rules files cannot import. KEEP IN
    // SYNC with functions/src/pricing.ts (which enforces) and
    // src/core/constants/pricing.ts (which drives the submission error).
    //
    // A typo catcher, not a business limit. Production held ₪554,545 and
    // ₪10,000,000 offers against a ₪300 median; an accepted ₪10M offer would have
    // carried a ₪300,000 platform fee.
    function offerPriceInRange() {
      return (!('price' in request.resource.data)
              || (request.resource.data.price >= 1 && request.resource.data.price <= 50000))
        && (!('bundlePrice' in request.resource.data)
              || (request.resource.data.bundlePrice >= 1 && request.resource.data.bundlePrice <= 50000));
    }

    // On UPDATE the bounds are checked only when the amount actually changes.
    // Checking unconditionally would judge a status-only write against the
    // document's existing price — so the ₪10,000,000 offer already in production
    // could never be declined, and the pro could never edit it back down. Editing
    // such an offer DOWN stays allowed; leaving it out of range does not.
    function offerPriceUnchangedOrInRange() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['price', 'bundlePrice'])
        || offerPriceInRange();
    }

    // `status` is not server-only — clients set 'open' at create and when
    // reposting roles (project-details.tsx:625-628). Only the TERMINAL
    // transitions belong to the callables.
    //
    // Terminal means terminal in BOTH directions. The previous version blocked
    // only ENTERING completed/cancelled, which left completed -> open,
    // completed -> in_progress and cancelled -> open all permitted: a client
    // could reopen a closed job, and with it the offers and fee machinery that
    // confirmCompletion had already settled. Reopening, if it is ever wanted,
    // goes through a callable.
    function statusTransitionAllowed() {
      return request.resource.data.get('status', '') == resource.data.get('status', '') ||
        (!(request.resource.data.get('status', '') in ['completed', 'cancelled']) &&
         !(resource.data.get('status', '') in ['completed', 'cancelled']));
    }

    // Every field a client legitimately writes to a project AFTER creation.
    // From the four client update sites:
    //   useProjectRequests.ts:67        crewSlots + SubmitDetails (title,
    //                                   description, exec, deadline, date,
    //                                   budget, vibe, location,
    //                                   targetProfessionalId, roleAnswers)
    //   project-details.tsx:183         deadline
    //   project-details.tsx:625-628     crewSlots, status
    //   project-details.tsx:390-393 and ReviewFlow.tsx:126-129
    //                                   reviewsCompleted, reviewsPending
    function clientProjectFields() {
      return [
        'crewSlots', 'title', 'description', 'exec', 'deadline', 'date',
        'budget', 'vibe', 'location', 'targetProfessionalId', 'roleAnswers',
        'status', 'reviewsCompleted', 'reviewsPending'
      ];
    }

    // True if the user is the project's client OR is in the project's group chat.
    // Professionals are added to the group chat's members[] when their offer is accepted.
    function isProjectParticipant(projectId) {
      let proj = projectDoc(projectId);
      return proj.clientId == request.auth.uid || (
        'chatId' in proj &&
        request.auth.uid in
          get(/databases/$(database)/documents/chats/$(proj.chatId)).data.members
      );
    }

    // ─── users ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      // Owners may update their own doc, but never their moderation state —
      // that is written only by the moderateUser callable (Admin SDK).
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderation']);
      allow delete: if false;

      match /profile/data {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }

      match /portfolio/{assetId} {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }
    }

    // ─── chats ──────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.members ||
        resource.data.type == 'community'  // all authed users can see community metadata for discovery
      );
      allow create: if isAuth() && (
        request.resource.data.type != 'community' || isAdmin()
      );
      // ── Update guard ────────────────────────────────────────────────────
      // Membership used to be the ONLY check, with no field restriction at all,
      // so any member of a community could rename it, replace its photo, kick
      // everyone else, forge `readOnly: true` (which the chat list reads as
      // project completion), or reassign `ownerId` to themselves — a takeover.
      // Same shape as the marketplace_listings hole.
      //
      // Everything is expressed as an allowlist over affectedKeys(), so a field
      // that is not named below CANNOT be written by a client at all — including
      // one added to the app later. That is deliberate: a new field is denied
      // until someone adds it here, rather than silently inheriting write access.
      //
      // Dotted-path writes (`unreadCount.<uid>`) surface in affectedKeys() as the
      // TOP-LEVEL key `unreadCount`. Verified on an emulator before this was
      // written, because sendMessage uses that shape on every single message and
      // a hasOnly() that rejected it would break all chat.

      function touchedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function isChatMember() {
        return isAuth() && request.auth.uid in resource.data.members;
      }
      // ownerId exists on communities only. On a dm/group/purchase doc this is
      // false, so the owner-only fields below are simply not client-writable
      // there — intended, not an oversight.
      function isChatOwner() {
        return isAuth() && resource.data.get('ownerId', '') == request.auth.uid;
      }

      // Any member: the message hot path, plus the purchase handshake and
      // archival, which marketplaceService writes from the client for BOTH
      // parties (PurchaseBanner -> acceptDeal / cancelPurchase / confirmReceived).
      function chatMemberFields() {
        return [
          'lastMessage', 'lastMessageAt', 'unreadCount', 'hiddenFor',
          'sellerAgreed', 'buyerAgreed',
          'archived', 'archiveReason', 'archivedAt'
        ];
      }
      // Identity/branding fields, scoped by chat TYPE rather than by ownership
      // alone — an owner-only rule across the board would deny these on groups,
      // which have no ownerId, and group photo editing is shipped behaviour
      // (ChatRoomScreen.tsx:965-967 gates only communities on ownership).
      // Deliberately NOT keyed off `roles`: Phase 1 found it vestigial — written
      // once at creation, never read for authorization, never verified.
      function chatType() {
        return resource.data.get('type', '');
      }
      // community: owner only.
      function chatOwnerFields() {
        return ['name', 'photoURL', 'description', 'category'];
      }
      // group: any member may change the PHOTO — that is shipped behaviour. `name`
      // is deliberately absent: createProjectGroup sets it once and no client path
      // ever updates it, so allowing it would be write surface with no feature
      // behind it. `description`/`category` are community-only (0 group docs carry
      // either) and stay out too.
      function groupEditableFields() {
        return ['photoURL'];
      }
      // dm and purchase get neither: no client path writes `name` or `photoURL`
      // after creation, dm docs carry neither field at all, and purchase `name`
      // is set once by createPurchaseChat.
      function chatWritableFields() {
        return chatType() == 'community'
          ? chatMemberFields().concat(chatOwnerFields()).concat(['members'])
          : chatType() == 'group'
          ? chatMemberFields().concat(groupEditableFields()).concat(['members'])
          : chatMemberFields().concat(['members']);
      }
      // NOT listed anywhere, therefore denied to every client:
      //   ownerId, status                  -> takeover / moderation; callable only
      //   readOnly, readOnlyReason, readOnlyAt -> written by confirmCompletion (Admin SDK)
      //   type, createdAt, projectId, purchaseListingId, buyerName, roles
      //                                    -> set at creation, never updated

      // A member may remove ONLY themselves. The new list must equal the old one
      // minus exactly the caller — so this cannot be used to kick anyone or to
      // add a uid while dropping self. Adds and kicks are the owner's.
      function isSelfRemoval() {
        return request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && !(request.auth.uid in request.resource.data.members);
      }

      allow update: if isChatMember()
        // 1. Nothing outside this type's client-writable union may be touched, so
        //    an unrecognised field cannot ride along in an otherwise-legal write.
        && touchedKeys().hasOnly(chatWritableFields())
        // 2. On a COMMUNITY, the branding fields require the owner. On a group
        //    they are member-editable and reach this clause already permitted by
        //    (1); on dm/purchase (1) has denied them outright.
        && (chatType() != 'community'
            || !touchedKeys().hasAny(chatOwnerFields())
            || isChatOwner())
        // 3. members: self-removal by anyone, add/kick by the owner. Groups have
        //    no ownerId, so client-side adds and kicks are denied there — correct,
        //    since hire.ts and removal.ts do both through the Admin SDK.
        && (!touchedKeys().hasAny(['members']) || isSelfRemoval() || isChatOwner());

      allow delete: if false;

      // direct messages
      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in chatMembers(chatId);
        // No client writes into a read-only chat (BAMA System DMs); Admin SDK bypasses.
        allow create: if isAuth() && request.auth.uid in chatMembers(chatId) && !chatReadOnly(chatId);
        allow update, delete: if false;
      }

      // community sub-channels
      match /channels/{channelId} {
        allow read, create, update: if isAuth() && request.auth.uid in chatMembers(chatId);
        // Only the community owner may delete, and never the General/Market channels.
        // resource.data.get('kind','') returns '' when absent → legacy/normal channels
        // (no kind) stay deletable by the owner; General/Market (kind set) are blocked.
        allow delete: if isAuth()
          && get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
          && resource.data.get('kind', '') != 'general'
          && resource.data.get('kind', '') != 'market';

        match /messages/{messageId} {
          allow read, create: if isAuth() && request.auth.uid in chatMembers(chatId);
          allow update, delete: if false;
        }
      }

      // community join requests
      match /joinRequests/{requestId} {
        // LOAD-BEARING: ChatRoomScreen only runs the collection query when the
        // caller is the community OWNER (it returns early otherwise). That works
        // because the owner clause below reads the parent chat and is therefore
        // provable from the query. The `request.auth.uid == requestId` clause is
        // the document-ID wildcard, which a query can never bind — so if that
        // owner gate is ever removed, the listener will be denied in production
        // and (unless its error handler logs) will look like "no pending
        // requests". Same failure that hid the removal-request bug.
        allow create: if isAuth() && request.auth.uid == requestId;
        allow read: if isAuth() && (
          request.auth.uid == requestId  // requester can read their own join status
          || get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
          || isAdmin()
        );
        allow update: if isAuth() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
          || isAdmin()
        );
        // The requester may withdraw their own request while it is still
        // pending — never once the owner has approved or rejected it.
        allow delete: if isAuth()
          && request.auth.uid == requestId
          && resource.data.status == 'pending';
      }
    }

    // ─── communityRequests ──────────────────────────────────────────
    match /communityRequests/{requestId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ─── courses ────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();

      // Per-user "Visit course" markers — doc id is the clicking user's uid, so
      // the unique-visitor count can't be inflated (repeat taps overwrite one
      // doc, and a user may write only their own). Only admins read the count.
      match /clicks/{userId} {
        allow read: if isAdmin();
        allow create, update: if isAuth() && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    // ─── courseRequests ─────────────────────────────────────────────
    match /courseRequests/{requestId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ─── projects ───────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isAuth();    // professionals browse the noticeboard
      // Clients create projects. `filledSlots: []` is fine; every other lifecycle
      // field must be absent so a client cannot self-assign feeStatus at create.
      allow create: if isAuth() &&
        request.resource.data.get('filledSlots', []) == [] &&
        !request.resource.data.keys().hasAny(
          serverOnlyProjectFields().removeAll(['filledSlots'])
        );
      // Only the client may update, and never a server-owned field. The former
      // "professionals may update filledSlots" branch is gone — removal now goes
      // through the freeSlot callable, which also maintains professionalIds.
      // hasOnly() is the primary guard — an unrecognised or newly-invented field
      // is denied rather than inherited. The serverOnly hasAny() below is kept
      // deliberately: it is redundant today, but it fails loudly if a
      // server-owned field is ever added to clientProjectFields() by mistake.
      allow update: if isAuth() &&
        resource.data.clientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(clientProjectFields()) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(serverOnlyProjectFields()) &&
        statusTransitionAllowed();
      // Deletion goes through the deleteProject callable (Admin SDK), which
      // cascades to priceOffers, bundleOffers, the fee subcollection and the
      // chat, and refuses once anyone is hired. A direct client delete could not
      // reach the fee docs at all — subcollections outlive their parent — and
      // would leave accepted offers orphaned, still priceable by computeProAmount.
      allow delete: if isAdmin();

      match /meetings/{meetingId} {
        allow read, create, update, delete: if isAuth() && isProjectParticipant(projectId);
      }

      match /missions/{missionId} {
        allow read, create, update, delete: if isAuth() && isProjectParticipant(projectId);
      }

      // Payment renegotiation — only the two parties involved
      match /paymentRequests/{paymentRequestId} {
        // INTERIM — see "PENDING DEPLOYS" at the top of
        // docs/known-issues-silent-failures.md. Creation has moved to the
        // createPaymentRequest callable; this stays open only until the app build
        // carrying that client ships, then becomes `if false`.
        //
        // The `toUserId != uid` clause is the hole being closed: create checked
        // fromUserId and the responder checked toUserId, so one person satisfied
        // both halves, addressed a request to themselves and accepted it —
        // unilaterally repricing an accepted offer, which is the platform fee's
        // base.
        allow create: if isAuth()
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.toUserId != request.auth.uid;
        allow read: if isAuth() && (
          resource.data.fromUserId == request.auth.uid ||
          resource.data.toUserId == request.auth.uid
        );
        // Answering goes through respondToPaymentRequest (Admin SDK), which
        // re-derives both parties from the project.
        allow update: if false;
        allow delete: if false;
      }

      // Per-professional platform fee. Doc id IS the pro's uid.
      // Admin SDK only for writes — a pro who could write this could zero their
      // own fee or free their own slot, which is the entire collection mechanism.
      // Only the pro themself reads it: per spec §6 the CLIENT is never told that
      // a professional owes money, so the client has no read here either.
      match /fees/{proId} {
        // Keyed off the FIELD, not the {proId} wildcard. A wildcard cannot be
        // bound by a collection query, so the wildcard form permits a direct get
        // while silently denying slice 2's cross-project fee list. The document
        // id and the professionalId field are always the same value.
        allow read: if isAuth() && resource.data.professionalId == request.auth.uid;
        allow write: if false;
      }

      // Removal requests — document ID is the professionalId being removed
      match /removalRequests/{professionalId} {
        allow create: if isAuth() && projectDoc(projectId).clientId == request.auth.uid;
        allow read: if isAuth() && (
          professionalId == request.auth.uid ||
          projectDoc(projectId).clientId == request.auth.uid
        );
        // The professional answers the request. The CLIENT may also write it —
        // `requestRemoval` uses setDoc, so a second press is an update, and
        // without this a client could never re-request after the pro ignored
        // one. Constrained to 'pending': only the professional can accept.
        allow update: if isAuth() && (
          professionalId == request.auth.uid ||
          (projectDoc(projectId).clientId == request.auth.uid &&
           request.resource.data.status == 'pending')
        );
        // Cleared by the freeSlot callable (Admin SDK bypasses rules), never by a client.
        allow delete: if false;
      }
    }

    // ─── priceOffers ────────────────────────────────────────────────
    match /priceOffers/{offerId} {
      allow create: if isAuth() && offerCreateValid();
      allow read: if isAuth() && (
        resource.data.professionalId == request.auth.uid ||
        projectDoc(resource.data.projectId).clientId == request.auth.uid
      );
      // offerAmountFrozenOnceAccepted() had a two-write bypass — accepted ->
      // pending, then edit the price. offerStatusUnchanged/offerClientDecline
      // close it: leaving 'accepted' is no longer a client transition at all.
      allow update: if isAuth() && (
        resource.data.professionalId == request.auth.uid ||
        projectDoc(resource.data.projectId).clientId == request.auth.uid
      )
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(offerClientFields())
        && (offerStatusUnchanged() || offerClientDecline())
        && offerPriceUnchangedOrInRange()
        && offerAmountFrozenOnceAccepted() && offerIdentityStable();
      allow delete: if false;
    }

    // ─── bundleOffers ───────────────────────────────────────────────
    match /bundleOffers/{offerId} {
      allow create: if isAuth() && offerCreateValid();
      allow read: if isAuth() && (
        resource.data.professionalId == request.auth.uid ||
        projectDoc(resource.data.projectId).clientId == request.auth.uid
      );
      allow update: if isAuth() && (
        resource.data.professionalId == request.auth.uid ||
        projectDoc(resource.data.projectId).clientId == request.auth.uid
      )
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(offerClientFields())
        && (offerStatusUnchanged() || offerClientDecline())
        && offerPriceUnchangedOrInRange()
        && offerAmountFrozenOnceAccepted() && offerIdentityStable();
      allow delete: if false;
    }

    // ─── marketplace_listings ────────────────────────────────────────
    // The update rule used to constrain WHO writes and never WHAT. Its third
    // clause — needed so a second buyer can run acceptDeal — let ANY signed-in
    // user write ANY fields to ANY available listing, provided the result carried
    // their own buyerId. Verified in production before this change: a non-owner
    // could rewrite posterId (taking the listing, which the delete rule below then
    // hands them), set status 'sold' (hiding it from the feed), rewrite price and
    // title, and forge sellerConfirmed. Setting buyerId once also granted
    // permanent access through the second clause, whatever the status became.
    //
    // Same shape as projects: identity frozen, transitions enumerated, and the
    // non-owner clause reduced to exactly the write it exists for.

    /** posterId and createdAt are identity — no client write may change them. */
    function listingIdentityStable() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['posterId', 'createdAt']);
    }

    /**
     * available -> reserved (accept), reserved -> sold (handover),
     * reserved -> available (cancel), or unchanged. 'sold' is unreachable from
     * 'available', and 'negotiating' — which no code path writes — from anywhere.
     */
    function listingStatusTransitionAllowed() {
      return request.resource.data.get('status', 'available') ==
               resource.data.get('status', 'available')
        || (resource.data.get('status', 'available') == 'available' &&
            request.resource.data.get('status', '') == 'reserved')
        || (resource.data.get('status', '') == 'reserved' &&
            request.resource.data.get('status', '') in ['sold', 'available']);
    }

    /**
     * A confirmation may be REMOVED (cancelPurchase deletes both halves) but only
     * its owner may SET it. Otherwise either party forges the other's half of the
     * handover handshake.
     */
    function notForgingConfirmation(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || !(field in request.resource.data);
    }

    /** The buyer's own fields, plus the cancel reset. Never price, never identity. */
    function listingBuyerKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'buyerId', 'purchaseChatId',
        'buyerConfirmed', 'buyerConfirmedAt',
        'sellerConfirmed', 'platformFee'
      ]);
    }

    match /marketplace_listings/{listingId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.posterId == request.auth.uid;
      allow update: if isAuth()
        && listingIdentityStable()
        && listingStatusTransitionAllowed()
        && (
          // Seller: edit their own listing, markHandedOver, accept, cancel. May set
          // buyerId to the buyer they accepted (acceptDeal passes the BUYER's uid
          // whichever party presses second), but may not forge the buyer's receipt.
          (resource.data.posterId == request.auth.uid &&
           notForgingConfirmation('buyerConfirmed')) ||

          // Existing buyer: confirmReceived and cancelPurchase on their own
          // purchase, and nothing else. May clear buyerId when cancelling, never
          // hand it to somebody else.
          (resource.data.buyerId == request.auth.uid &&
           listingBuyerKeysOnly() &&
           notForgingConfirmation('sellerConfirmed') &&
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['buyerId'])
            || !('buyerId' in request.resource.data)
            || request.resource.data.buyerId == request.auth.uid)) ||

          // New buyer taking an available listing: EXACTLY acceptDeal's three
          // fields, and only into 'reserved'. This is the clause that was open.
          (resource.data.get('status', '') == 'available' &&
           request.resource.data.get('status', '') == 'reserved' &&
           request.resource.data.buyerId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'buyerId', 'purchaseChatId']))
        );
      allow delete: if isAuth() && (resource.data.posterId == request.auth.uid || isAdmin());
    }

    // ─── reviews ────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      // LATENT PLUMBING — READ THIS BEFORE WRITING `published: false` ANYWHERE.
      //
      // Reviews are never held. onReviewCreate writes `published: true` on every
      // review, unconditionally; nothing in the codebase writes `false`. These two
      // clauses are the surviving enforcement half of a removed mechanism that hid
      // a client's review until the professional paid their commission.
      //
      // They are inert only because nothing sets the field to false. Any future
      // writer of `published: false` silently re-creates a visibility gate with no
      // change to this file — and the `list` clause below would hide such a review
      // from EVERY query, including the professional's own profile. If you are
      // about to write that value, you are re-introducing the thing we removed.
      //
      // GET and LIST are split because they are enforced differently.
      //
      // `get` is evaluated per document, so the full condition works. The
      // get() default keeps any legacy field-less review readable.
      allow get: if isAuth() && (
        resource.data.get('published', true) != false ||
        request.auth.uid != resource.data.professionalId
      );
      // `list` must be provable from the QUERY, not the document. The condition
      // above is NOT: production returned a professional their own held review
      // (rating and body) through where('professionalId','==',uid), while
      // denying a direct get on the very same document. A `.get(field, default)`
      // comparison does not constrain a query; a plain equality does — the
      // notifications rule proves the shape works, denying an unconstrained list
      // and allowing where('userId','==',uid).
      //
      // So every query on reviews must carry where('published','==',true).
      // No read path wants held reviews: the professional must not see them, and
      // public profiles and search only ever show published ones. The server
      // publishes via the Admin SDK, which bypasses rules.
      //
      // This depends on EVERY review carrying `published`
      // (scripts/backfill-review-published.mjs) — without the field the equality
      // is unsatisfiable and the document silently vanishes from every list.
      allow list: if isAuth() && resource.data.published == true;
      // published/visibleAt are resolved by the onReviewCreate trigger, which sets
      // them unconditionally. Denied at create so a client cannot pre-set a review
      // invisible — the one way the removed hold could come back from the outside.
      // You cannot review yourself. Nothing used to constrain professionalId, so
      // a self-review could be POSTed straight through the SDK — no project and
      // no hire needed — and it counted toward the author's own public rating.
      // Blocking self-hire removes the route the UI offers; this removes the
      // hole. Existing self-reviews are untouched: reviews are already immutable
      // to clients (`allow update, delete: if false`) and this constrains only
      // creation.
      allow create: if isAuth() &&
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.professionalId != request.auth.uid &&
        !request.resource.data.keys().hasAny(['published', 'visibleAt']);
      allow update, delete: if false;  // reviews are immutable (Admin SDK bypasses)
    }

    // ─── reports ────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isAuth() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin();
      allow update: if isAdmin() || (
        // Reporter may add evidence images after initial submission
        isAuth() &&
        resource.data.reporterId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evidenceURLs'])
      );
      allow delete: if false;
    }

    // ─── adminActions ───────────────────────────────────────────────
    // Append-only evidence log. Written exclusively by the moderateUser
    // callable (Admin SDK bypasses rules); admins may read.
    match /adminActions/{actionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ─── cancellations ──────────────────────────────────────────────
    // Append-only audit trail of purchase cancellations (project cancellations
    // are read live from `projects`). Written by the cancelling user; only
    // admins read. Never editable.
    match /cancellations/{id} {
      allow create: if isAuth() && request.resource.data.actorId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ─── notifications ───────────────────────────────────────────────
    // Written exclusively by Cloud Functions (Admin SDK bypasses rules).
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ─── pushTokens ──────────────────────────────────────────────────
    // Device push tokens, keyed by the token string. Clients never read; the
    // Cloud Function sender uses the Admin SDK (bypasses rules). A user may
    // only claim/refresh a token for themselves, and delete their own on logout.
    match /pushTokens/{tokenId} {
      allow read: if false;
      allow create, update: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── videoJobs ───────────────────────────────────────────────────
    // Written exclusively by the transcoding Cloud Function (Admin SDK bypasses rules).
    // Clients read via onSnapshot to await job completion during video upload.
    match /videoJobs/{jobId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ─── projectApplications ─────────────────────────────────────────
    // Written client-side but not queried client-side (possible future admin view).
    match /projectApplications/{applicationId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ─── subscriptions ──────────────────────────────────────────────
    // INERT. There is no subscription product: a paid tier used to lift the
    // open-project cap, which made capacity purchasable. Nothing reads this
    // collection any more — `hireProfessional` does not consult it. Kept
    // Admin-SDK-only rather than deleted so the documents stay tamper-proof.
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Collection-group read over every projects/{id}/fees/{proId}, so a pro can
    // list their own outstanding fees across projects in one query. The
    // subcollection rule above does NOT authorise a collectionGroup query — that
    // needs its own path-pattern match. Scoped identically: the doc id must be
    // the caller's uid, so this grants nothing the direct read does not.
    match /{path=**}/fees/{proId} {
      // Field-keyed for the same reason as the subcollection rule above: a
      // collectionGroup('fees').where('professionalId','==',uid) query cannot
      // bind {proId}, so the wildcard form would deny the very query this rule
      // exists to permit.
      allow read: if isAuth() && resource.data.professionalId == request.auth.uid;
      allow write: if false;
    }

    // ─── config ──────────────────────────────────────────────────────
    // Runtime pricing config (config/pricing): the platform fee percent, the
    // open-project cap, the dispute window and the auto-close periods. Written
    // ONLY by the Admin SDK / console — a client that could write this would set
    // its own commission rate to zero and raise its own project cap.
    //
    // Readable by any signed-in user because the app must DISPLAY the rate and
    // the cap rather than invent them; there is nothing private in it.
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ─── deny everything not explicitly listed ────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
