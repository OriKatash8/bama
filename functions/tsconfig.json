{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "es2020",
    "esModuleInterop": true
  },
  "compileOnSave": true,
  // Tests are run by the ROOT jest (they import the pure modules directly);
  // they must not be compiled into lib/ and shipped with the functions.
  "exclude": ["src/**/__tests__/**"],
  "include": ["src"]
}
