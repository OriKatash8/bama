{
  "expo": {
    "name": "BAMA",
    "slug": "bama",
    "scheme": "bama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/bama.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.bamaapp.bama",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "BAMA uses the microphone to record voice messages in chats.",
        "CFBundleAllowMixedLocalizations": true
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bamaapp.bama"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-video",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities/Environment", "modular_headers": true },
              { "name": "GoogleUtilities/UserDefaults", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "BAMA uses the microphone to record voice messages in chats."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BAMA uses your photo library so you can choose photos and videos for your profile, portfolio, chats and marketplace listings.",
          "cameraPermission": "BAMA uses the camera so you can take a photo and send it in a chat.",
          "microphonePermission": "BAMA uses the microphone to record voice messages in chats."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#208AEF"
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/app-check"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b693c677-cec0-4f8b-baed-2333d9418a66"
      }
    },
    "locales": {
      "he": "./locales/he.json",
      "en": "./locales/en.json"
    }
  }
}
